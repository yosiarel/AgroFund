// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PENDANA
  UMKM
  KOPERASI
  AGROFUND
}

enum ProjectStatus {
  DRAFT
  COOPERATIVE_ASSESSMENT
  PUBLICATION_REVIEW
  GUARANTEE_PLACEMENT
  FUNDRAISING
  DANA_TERPENUHI
  PROCUREMENT
  EXECUTION
  NATURA_FULFILLMENT
  SUKSES_DITUTUP
  GAGAL_DITUTUP
}

enum GuaranteeStatus {
  PENDING_PAYMENT
  HELD
  PARTIALLY_USED
  USED
  RETURNED
  RECOVERY_POOL
}

enum AssessmentStatus {
  PENDING
  APPROVED
  NEEDS_CORRECTION
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects            Project[]      @relation("UmkmProjects")
  cooperativeProjects Project[]      @relation("KoperasiProjects")
  contributions       Contribution[]
  assessedAssessments Assessment[]   @relation("KoperasiAssessor")
}

model Project {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation("UmkmProjects", fields: [userId], references: [id])
  koperasiId String?
  koperasi   User?   @relation("KoperasiProjects", fields: [koperasiId], references: [id])

  title       String
  description String

  basicProcurementCapital BigInt
  priceReserve            BigInt @default(0)
  cooperativeFeeProvision BigInt @default(0)
  agrofundServiceFee      BigInt @default(0)
  naturaCost              BigInt @default(0)
  mandatoryTaxes          BigInt @default(0)
  targetAmount            BigInt // Computed/Sum of above

  fundedAmount BigInt        @default(0)
  status       ProjectStatus @default(DRAFT)

  guaranteeAmount BigInt          @default(0)
  guaranteeStatus GuaranteeStatus @default(PENDING_PAYMENT)

  fundraisingDeadline DateTime?
  publishedAt         DateTime?
  failedReason        String?
  imageUrl            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  naturaPackages        NaturaPackage[]
  contributions         Contribution[]
  procurementRequests   ProcurementRequest[]
  milestones            Milestone[]
  incidents             Incident[]
  financialLedgers      ProjectFinancialLedger[]
  assessments           Assessment[]
  guaranteeTransactions GuaranteeTransaction[]
}

model Assessment {
  id         String           @id @default(uuid())
  projectId  String
  project    Project          @relation(fields: [projectId], references: [id])
  type       String // COOPERATIVE, AGROFUND
  assessorId String
  assessor   User             @relation("KoperasiAssessor", fields: [assessorId], references: [id])
  status     AssessmentStatus @default(PENDING)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model NaturaPackage {
  id                   String    @id @default(uuid())
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id])
  name                 String
  description          String
  amount               BigInt
  expectedDeliveryDate DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  contributions Contribution[]
}

model Contribution {
  id               String         @id @default(uuid())
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id])
  investorId       String
  investor         User           @relation(fields: [investorId], references: [id])
  amount           BigInt
  processingFee    BigInt         @default(0)
  totalPayment     BigInt // amount + processingFee
  naturaPackageId  String?
  naturaPackage    NaturaPackage? @relation(fields: [naturaPackageId], references: [id])
  status           String         @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, CANCELLED, REFUNDED
  paymentReference String?        @unique
  paymentUrl       String?
  idempotencyKey   String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model GuaranteeTransaction {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  amount      BigInt
  reason      String?
  referenceId String?
  status      String   @default("HELD") // HELD, USED, RETURNED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProcurementRequest {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  status    String   @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, PO_ISSUED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  ProcurementItem[]
  orders PurchaseOrder[]
}

model ProcurementItem {
  id                   String             @id @default(uuid())
  procurementRequestId String
  request              ProcurementRequest @relation(fields: [procurementRequestId], references: [id])
  name                 String
  quantity             Int
  estimatedUnitPrice   BigInt
  createdAt            DateTime           @default(now())
}

model SupplierRecord {
  id                  String   @id @default(uuid())
  name                String
  contactInfo         String?
  businessInformation String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id                   String             @id @default(uuid())
  procurementRequestId String
  request              ProcurementRequest @relation(fields: [procurementRequestId], references: [id])
  supplierId           String
  supplier             SupplierRecord     @relation(fields: [supplierId], references: [id])
  quotedTotal          BigInt
  status               String             @default("DRAFT") // DRAFT, VALID, PROCUREMENT_COMMITTED, PAID
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  evidences Evidence[]
}

model Evidence {
  id            String         @id @default(uuid())
  referenceType String // PO, PROGRESS_REPORT, INCIDENT
  referenceId   String
  purchaseOrder PurchaseOrder? @relation(fields: [referenceId], references: [id], map: "ev_po_fkey")
  fileUrl       String
  description   String?
  type          String // RECEIPT, PHOTO, DOCUMENT
  status        String         @default("SUBMITTED")
  createdAt     DateTime       @default(now())
}

model ProjectFinancialLedger {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  remainingBalance BigInt
  updatedAt        DateTime @updatedAt
}

model FinancialTransaction {
  id            String   @id @default(uuid())
  projectId     String
  type          String // CONTRIBUTION, PROCUREMENT_PAYMENT, FEE_PAYMENT, REFUND
  direction     String // IN, OUT
  amount        BigInt
  currency      String   @default("IDR")
  source        String
  destination   String
  referenceType String?
  referenceId   String?
  status        String   @default("SUCCESS")
  createdAt     DateTime @default(now())
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  name        String
  description String?
  plannedDate DateTime?
  status      String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reports ProgressReport[]
}

model ProgressReport {
  id                 String    @id @default(uuid())
  milestoneId        String
  milestone          Milestone @relation(fields: [milestoneId], references: [id])
  progressPercentage Int
  description        String
  status             String    @default("SUBMITTED")
  createdAt          DateTime  @default(now())
}

model Incident {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  category    String // DELAY, DAMAGE, FRAUD
  severity    String // LOW, MEDIUM, HIGH
  description String
  status      String   @default("UNDER_REVIEW") // UNDER_REVIEW, RESOLVED
  decision    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
